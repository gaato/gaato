import {
  "gaato/github",
  "gaato/mttp" @http,
  "gaato/mttp/rt",
  "gaato/mttp_async/backend",
  "gaato/mttp_async/runtime",
  "gaato/mttp/client",
  "gaato/mttp/cookie",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "gaato/profile-readme/src/activity",
}

pkgtype(kind: "executable")

supported_targets = "native + wasm"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
  ],
)
